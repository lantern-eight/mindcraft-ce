{
    "name": "mindcraft",
    "version": "0.7.0",
    "license": "MIT AND CC0-1.0",
    "type": "module",
    "engines": {
        "node": ">=22.13.0"
    },
    "dependencies": {
        "@anthropic-ai/sdk": "0.112.3",
        "@cerebras/cerebras_cloud_sdk": "1.91.0",
        "@eslint/js": "10.0.1",
        "@google/genai": "2.12.0",
        "@huggingface/inference": "4.13.23",
        "@mistralai/mistralai": "2.5.0",
        "canvas": "3.2.3",
        "cheerio": "1.2.0",
        "eslint": "10.7.0",
        "eslint-plugin-no-floating-promise": "2.0.0",
        "express": "5.2.1",
        "globals": "17.7.0",
        "google-translate-api-x": "10.7.3",
        "groq-sdk": "1.3.0",
        "minecraft-assets": "1.17.0",
        "minecraft-data": "github:lantern-eight/node-minecraft-data#194d7f6068e474f006d8d21d922f8aef7863751a",
        "mineflayer": "github:lantern-eight/mineflayer#4422a455c78cb7182556751abcfbaa34fdf98f2c",
        "mineflayer-armor-manager": "2.0.1",
        "mineflayer-auto-eat": "5.0.3",
        "mineflayer-collectblock": "1.6.0",
        "mineflayer-pathfinder": "github:lantern-eight/mineflayer-pathfinder#ee36727aeb4382b7215c65633c393dc28ae1e79b",
        "mineflayer-pvp": "1.3.2",
        "node-canvas-webgl": "0.3.0",
        "open": "11.0.0",
        "openai": "6.48.0",
        "prismarine-item": "1.18.0",
        "prismarine-viewer": "1.33.0",
        "replicate": "1.4.0",
        "ses": "2.2.0",
        "socket.io": "4.8.3",
        "socket.io-client": "4.8.3",
        "three": "0.128.0",
        "vec3": "0.2.0",
        "yargs": "18.0.0"
    },
    "overrides": {
        "canvas": "3.2.3",
        "gl": "8.1.6",
        "minecraft-data": "$minecraft-data",
        "mineflayer": "$mineflayer",
        "mineflayer-pathfinder": "$mineflayer-pathfinder",
        "minecraft-protocol": "github:lantern-eight/node-minecraft-protocol#3473413d32ee09af55aa77579000391be3bb9753",
        "prismarine-chunk": "github:lantern-eight/prismarine-chunk#51132c76b618fe0b3dc06946bf45697c10b27412",
        "prismarine-physics": "github:lantern-eight/prismarine-physics#81b4157401b75365de93240ed7daca6df855cf03",
        "prismarine-registry": "github:lantern-eight/prismarine-registry#9f6206a619d52977694fcf52eb42b8d58849a5fa",
        "prismarine-block": "github:lantern-eight/prismarine-block#e4fcd1cc89f38cec27f3035e6475797c05d0b1ae",
        "bedrock-protocol": "3.61.0"
    },
    "scripts": {
        "postinstall": "patch-package --error-on-fail",
        "start": "node main.js",
        "reinstall": "npm run clean:modules && npm ci",
        "clean:modules": "node -e \"const fs=require('fs');if(fs.existsSync('node_modules'))fs.rmSync('node_modules',{recursive:true,force:true});\"",
        "test": "node --test tests/*.test.js",
        "test:live:mining": "node tests/live/mining_scenarios.js"
    },
    "devDependencies": {
        "patch-package": "8.0.1"
    }
}
