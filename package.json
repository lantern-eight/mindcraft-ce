{
    "name": "mindcraft",
    "version": "1.2.2-bedrock.1.3.1",
    "license": "MIT AND CC0-1.0",
    "type": "module",
    "engines": {
        "node": ">=22.13.0"
    },
    "dependencies": {
        "@anthropic-ai/sdk": "0.112.3",
        "@cerebras/cerebras_cloud_sdk": "1.91.0",
        "@eslint/js": "10.0.1",
        "@google/genai": "2.12.0",
        "@huggingface/inference": "4.13.23",
        "@mistralai/mistralai": "2.5.0",
        "canvas": "3.2.3",
        "cheerio": "1.2.0",
        "eslint": "10.7.0",
        "eslint-plugin-no-floating-promise": "2.0.0",
        "express": "5.2.1",
        "globals": "17.7.0",
        "google-translate-api-x": "10.7.3",
        "groq-sdk": "1.3.0",
        "minecraft-assets": "1.17.0",
        "minecraft-data": "github:lantern-eight/node-minecraft-data#aa55657598a165091a06ae1b7f58484ec63976f4",
        "mineflayer": "github:lantern-eight/mineflayer#ad4af12611fd55309bb387b2b416212bffb0eddf",
        "mineflayer-armor-manager": "2.0.1",
        "mineflayer-auto-eat": "5.0.3",
        "mineflayer-collectblock": "1.6.0",
        "mineflayer-pathfinder": "2.4.5",
        "mineflayer-pvp": "1.3.2",
        "node-canvas-webgl": "0.3.0",
        "open": "11.0.0",
        "openai": "6.48.0",
        "prismarine-item": "1.18.0",
        "prismarine-viewer": "1.33.0",
        "replicate": "1.4.0",
        "ses": "2.2.0",
        "socket.io": "4.8.3",
        "socket.io-client": "4.8.3",
        "three": "0.128.0",
        "vec3": "0.2.0",
        "yargs": "18.0.0"
    },
    "overrides": {
        "canvas": "3.2.3",
        "gl": "8.1.6",
        "minecraft-data": "$minecraft-data",
        "mineflayer": "$mineflayer",
        "minecraft-protocol": "github:lantern-eight/node-minecraft-protocol#3473413d32ee09af55aa77579000391be3bb9753",
        "prismarine-chunk": "github:lantern-eight/prismarine-chunk#a96fd7050163b5ae3cbce240deab453a03cd3bc2",
        "prismarine-physics": "github:lantern-eight/prismarine-physics#e641ceb574e42e8a3cdc8cecbcf2c0d2bf5d729b"
    },
    "scripts": {
        "postinstall": "patch-package --error-on-fail",
        "start": "node main.js",
        "reinstall": "npm run clean:modules && npm ci",
        "clean:modules": "node -e \"const fs=require('fs');if(fs.existsSync('node_modules'))fs.rmSync('node_modules',{recursive:true,force:true});\"",
        "test": "node --test tests/*.test.js",
        "test:live:mining": "node tests/live/mining_scenarios.js"
    },
    "devDependencies": {
        "patch-package": "8.0.1"
    }
}
